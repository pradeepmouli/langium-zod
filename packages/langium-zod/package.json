{
  "name": "langium-zod",
  "version": "0.12.1",
  "type": "module",
  "description": "Langium generator plugin that derives Zod schemas from grammar definitions",
  "keywords": [
    "langium",
    "zod",
    "codegen",
    "typescript",
    "ast"
  ],
  "homepage": "https://github.com/pradeepmouli/langium-zod#readme",
  "bugs": {
    "url": "https://github.com/pradeepmouli/langium-zod/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pradeepmouli/langium-zod.git",
    "directory": "packages/langium-zod"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "langium-zod": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "vitest run",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "humanize-string": "^3.1.0",
    "langium": "^4.4.0",
    "x-to-zod": "^0.10.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "langium-cli": "^4.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "author": "Pradeep Mouli <pmouli@mac.com> (https://github.com/pradeepmouli)"
}
